# Configuration du serveur de jeu Java
# Copiez ce fichier en .env et adaptez les valeurs selon vos besoins

# Port sur lequel le serveur écoute
PORT=8080

# Chemin vers le JAR du jeu
GAME_JAR=./public/games/KuenosGame.jar

# Arguments à passer au processus Java (optionnel)
# JAVA_ARGS=-Xmx1024m -Xms512m

# Mode de débogage
DEBUG=false

# URL du serveur WebSocket (côté client)
VITE_GAME_SERVER_URL=ws://localhost:8080

# Timeout en millisecondes pour arrêter les jeux (30 secondes par défaut)
GAME_TIMEOUT=30000

# Nombre maximum de jeux simultanés (-1 = illimité)
MAX_CONCURRENT_GAMES=-1
